---
############################################
#DEPLOYING ClickHouse
############################################
#Reference: https://github.com/ClickHouse/clickhouse-operator/blob/main/dist/chart/values.yaml
#           https://clickhouse.com/blog/clickhouse-kubernetes-operator
#           https://github.com/ClickHouse/clickhouse-operator/tree/main
#           https://github.com/ClickHouse/clickhouse-operator/tree/main/examples

# https://kubernetes-schemas.pages.dev/fluxcd.controlplane.io/resourceset_v1.json
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: clickhouse-operator
  namespace: flux-system
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "1h"
    fluxcd.controlplane.io/reconcileTimeout: "20m"
spec:
  dependsOn:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: FluxInstance
      name: flux
      namespace: flux-system
      ready: true
    #Requirement for storageclass
    #Requirement for cert-manager
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      name: cert-manager-stack
      namespace: cert-manager
      ready: true
  resources:
    - apiVersion: v1
      kind: Namespace
      metadata:
        name: clickhouse-operator
        labels:
          pod-security.kubernetes.io/enforce: privileged
    # OCI Repository
    # https://github.com/ClickHouse/clickhouse-operator/tree/main/dist/chart
    - apiVersion: source.toolkit.fluxcd.io/v1
      kind: OCIRepository
      metadata:
        name: clickhouse-operator
        namespace: flux-system
      spec:
        interval: 12h
        url: oci://ghcr.io/clickhouse/clickhouse-operator-helm
        layerSelector:
          mediaType: "application/vnd.cncf.helm.chart.content.v1.tar+gzip"
          operation: copy
        ref:
          semver: "0.0.*"
    # Helm Release
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      metadata:
        name: clickhouse-operator
        namespace: clickhouse-operator
      spec:
        #serviceAccountName: clickhouse-sa
        chartRef:
          kind: OCIRepository
          name: clickhouse-operator
          namespace: flux-system
        interval: 30m
        timeout: 15m0s
        install:
          remediation:
            retries: 3
        upgrade:
          remediation:
            retries: 2
        driftDetection:
          mode: enabled
        values:
          crd:
            enable: true
            keep: false
    # ClickHouse Cluster Instantiation with CRD
    # Follow the CRD approach below to create other ClickHouse clusters if needed
    - apiVersion: clickhouse.com/v1alpha1
      kind: KeeperCluster
      metadata:
        name: clickhouse-cluster-keeper
        namespace: clickhouse-operator
      spec:
        replicas: 3
        dataVolumeClaimSpec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi
    - apiVersion: clickhouse.com/v1alpha1
      kind: ClickHouseCluster
      metadata:
        name: clickhouse-cluster
        namespace: clickhouse-operator
      spec:
        replicas: 2
        dataVolumeClaimSpec:
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 100Gi
        keeperClusterRef:
          name: clickhouse-cluster-keeper