############################################
#DEPLOYING TRIVY SCANNER
############################################
# Reference: https://github.com/stevehipwell/helm-charts/tree/main/charts/vertical-pod-autoscaler

apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: vertical-pod-autoscaler
  namespace: flux-system
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "1h"
    fluxcd.controlplane.io/reconcileTimeout: "20m"
spec:
  dependsOn:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: FluxInstance
      name: flux
      namespace: flux-system
      ready: true
  resources:
    - apiVersion: source.toolkit.fluxcd.io/v1
      kind: OCIRepository
      metadata:
        name: vertical-pod-autoscaler
        namespace: flux-system
      spec:
        interval: 12h
        url: oci://ghcr.io/stevehipwell/helm-charts/vertical-pod-autoscaler
        layerSelector:
          mediaType: "application/vnd.cncf.helm.chart.content.v1.tar+gzip"
          operation: copy
        ref:
          semver: "1.12.*"
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      metadata:
        name: vertical-pod-autoscaler
        namespace: kube-system
      spec:
        #serviceAccountName: flux-operator
        chartRef:
          kind: OCIRepository
          name: vertical-pod-autoscaler
          namespace: flux-system
        interval: 30m
        timeout: 15m0s
        install:
          remediation:
            retries: 3
        upgrade:
          remediation:
            retries: 2
        driftDetection:
          mode: enabled