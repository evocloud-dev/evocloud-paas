############################################
#DEPLOYING ClusterSecret Operator
############################################
# Reference: https://github.com/SAP/clustersecret-operator
#            https://github.com/sap/clustersecret-operator-helm

apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: clustersecret-operator
  namespace: flux-system
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "1h"
    fluxcd.controlplane.io/reconcileTimeout: "20m"
spec:
  dependsOn:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: FluxInstance
      name: flux
      namespace: flux-system
      ready: true
  resources:
    - apiVersion: source.toolkit.fluxcd.io/v1
      kind: OCIRepository
      metadata:
        name: clustersecret-operator
        namespace: flux-system
      spec:
        interval: 12h
        url: oci://ghcr.io/sap/clustersecret-operator-helm/clustersecret-operator
        layerSelector:
          mediaType: "application/vnd.cncf.helm.chart.content.v1.tar+gzip"
          operation: copy
        ref:
          semver: "0.3.*"
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      metadata:
        name: clustersecret-operator
        namespace: evocloud-ns
      spec:
        #serviceAccountName: flux-operator
        chartRef:
          kind: OCIRepository
          name: clustersecret-operator
          namespace: flux-system
        interval: 30m
        timeout: 15m0s
        install:
          remediation:
            retries: 3
        upgrade:
          remediation:
            retries: 2
        driftDetection:
          mode: enabled
        values:
          controller:
            replicaCount: 1