---
############################################
#DEPLOYING DRAGONFLY (CNCF P2P DISTRIBUTION)
############################################
# Reference: https://github.com/dragonflyoss/helm-charts
# Docs:      https://d7y.io/docs/getting-started/installation/helm-charts/
#
# Lightweight deployment: no Manager / MySQL / Redis (chart defaults).
# Components: scheduler (StatefulSet), seed-client (StatefulSet),
#             client (DaemonSet on every node) + dfinit init container
#             that rewrites containerd registry config on each node.

# https://kubernetes-schemas.pages.dev/fluxcd.controlplane.io/resourceset_v1.json
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: dragonfly-p2p
  namespace: flux-system
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "1h"
    fluxcd.controlplane.io/reconcileTimeout: "15m"
spec:
  dependsOn:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: FluxInstance
      name: flux
      namespace: flux-system
      ready: true
    # Add dependsOn storageClass   (seed-client persists its cache)
    # Add dependsOn Monitoring Stack (if enabling serviceMonitor)
    # Add dependsOn Cert-Manager   (only if enabling the injector webhook)

  resources:
    #Create Namespace
    - apiVersion: v1
      kind: Namespace
      metadata:
        name: dragonfly-system

    #Create Helm Repository
    # dragonflyoss does not publish its charts as OCI artifacts,
    # so this uses a classic HTTP HelmRepository instead of an OCIRepository.
    - apiVersion: source.toolkit.fluxcd.io/v1
      kind: HelmRepository
      metadata:
        name: kubeapp-dragonfly
        namespace: flux-system
      spec:
        interval: 12h
        url: https://dragonflyoss.github.io/helm-charts/

    #Deploy Helm Release
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      metadata:
        name: kubeapp-dragonfly
        namespace: dragonfly-system
      spec:
        releaseName: dragonfly
        chart:
          spec:
            chart: dragonfly
            version: "1.8.*"
            sourceRef:
              kind: HelmRepository
              name: kubeapp-dragonfly
              namespace: flux-system
            interval: 12h
        interval: 30m
        timeout: 10m0s
        install:
          remediation:
            retries: 3
        upgrade:
          cleanupOnFail: true
          remediation:
            retries: 2
        driftDetection:
          mode: enabled
        values:
          # Image tags default to the chart appVersion; override only to pin.
          scheduler:
            metrics:
              enable: true
              #serviceMonitor:
              #  enable: true

          seedClient:
            metrics:
              enable: true
              #serviceMonitor:
              #  enable: true
            resources:
              requests:
                cpu: '8'
                memory: '16Gi'
              limits:
                cpu: '8'
                memory: '16Gi'


          client:
            metrics:
              enable: true
              #serviceMonitor:
              #  enable: true
            dfinit:
              enable: true
              config:
                containerRuntime:
                  containerd:
                    configPath: /etc/containerd/config.toml
                    # Route every registry through Dragonfly via a single
                    # _default/hosts.toml. containerd falls back to the
                    # upstream registry if the local client is unavailable.
                    proxyAllRegistries: true
            resources:
              requests:
                cpu: '250m'
                memory: '512Mi'
              limits:
                cpu: '4'
                memory: '8Gi'

          # Manager + MySQL + Redis: required for Harbor P2P preheat
          # (Open API that Harbor calls), web console and multi-cluster.
          manager:
            enable: true
            metrics:
              enabled: true
          mysql:
            enable: true
          redis:
            enable: true

          # Optional: webhook that injects dfget/dfdaemon into annotated pods
          # (requires cert-manager)
          #injector:
          #  enable: true
          #  replicas: 2
          #  certManager:
          #    enable: true
          #    issuer:
          #      kind: Issuer
          #      create: true
          #   resources:
          #       requests:
          #         cpu: '250m'
          #         memory: '512Mi'
          #       limits:
          #         cpu: '2'
          #         memory: '4Gi'
