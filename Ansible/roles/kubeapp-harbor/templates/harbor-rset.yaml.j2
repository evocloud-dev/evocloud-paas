############################################
#DEPLOYING HARBOR
############################################
# Reference: https://github.com/goharbor/harbor-helm
#
# All credentials are set inline in the HelmRelease values; the chart creates the
# Kubernetes Secrets itself. Replace every CHANGE_ME before deploying.
#   harborAdminPassword  initial admin password
#   secretKey            exactly 16 chars; encrypts data in the DB, never change it
#   s3.accesskey/secretkey
#
# The chart generates core.secret, jobservice.secret, registry.secret and core.xsrfKey
# itself when left empty.
#
# TLS: terminated at the Gateway listener; the chart only renders the HTTPRoute.

apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: kubeapp-harbor
  namespace: flux-system
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "1h"
    fluxcd.controlplane.io/reconcileTimeout: "20m"
spec:
  dependsOn:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: FluxInstance
      name: flux
      namespace: flux-system
      ready: true

  resources:
    #Namespace (applied first by the operator, before any namespaced resource)
    - apiVersion: v1
      kind: Namespace
      metadata:
        name: harbor

    #Create Helm Repository
    - apiVersion: source.toolkit.fluxcd.io/v1
      kind: HelmRepository
      metadata:
        name: kubeapp-harbor
        namespace: flux-system
      spec:
        interval: 12h
        url: https://helm.goharbor.io

    #Deploy Helm Release
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      metadata:
        name: kubeapp-harbor
        namespace: harbor
      spec:
        releaseName: harbor
        chart:
          spec:
            chart: harbor
            version: "1.19.*"
            interval: 12h
            sourceRef:
              kind: HelmRepository
              name: kubeapp-harbor
              namespace: flux-system   # required: defaults to the HelmRelease namespace (harbor)
        interval: 30m
        timeout: 15m0s   # core crash-loops until Postgres is ready; give it room
        install:
          remediation:
            retries: 3
        upgrade:
          cleanupOnFail: true
          remediation:
            retries: 2
        driftDetection:
          mode: enabled
        values:
          externalURL: https://harbor.example.com

          # The chart renders an HTTPRoute (api/service/v2/c -> core, / -> portal).
          # TLS terminates at the Gateway listener, so chart TLS must stay off:
          # with it on, core mounts a cert secret that is never created for routes.
          expose:
            type: route
            tls:
              enabled: false
            route:
              parentRefs:
                - name: CHANGE_ME            # your Gateway
                  namespace: CHANGE_ME       # its namespace
                  sectionName: https         # the HTTPS listener
                  group: gateway.networking.k8s.io
                  kind: Gateway
              hosts:
                - harbor.example.com

          harborAdminPassword: "CHANGE_ME"
          secretKey: "CHANGE_ME_16char"   # must be exactly 16 chars

          persistence:
            enabled: true
            imageChartStorage:
              disableredirect: false   # true = registry proxies blob traffic instead of redirecting clients to S3
              type: s3
              s3:
                accesskey: "CHANGE_ME"
                secretkey: "CHANGE_ME"
                region: "CHANGE_ME"
                bucket: "CHANGE_ME"
                encrypt: true
                secure: true
                v4auth: true
            persistentVolumeClaim:
              trivy:
                size: 10Gi
              database:
                size: 50Gi
                storageClass: "CHANGE_ME"

          # Harbor's bundled Postgres -- single replica, own PVC, no HA
          database:
            type: internal
            internal:
              resources:
                requests:
                  cpu: 250m
                  memory: 256Mi
                limits:
                  memory: 512Mi
            maxIdleConns: 20
            maxOpenConns: 100

          # Bundled Redis for now. Switch to type: external when you pick one.
          redis:
            type: internal

          portal:
            replicas: 2
            resources:
              requests:
                cpu: 100m
                memory: 128Mi
              limits:
                memory: 256Mi
          core:
            replicas: 3
            podDisruptionBudget:
              enabled: true
              minAvailable: 2
            topologySpreadConstraints:
              - maxSkew: 1
                topologyKey: topology.kubernetes.io/zone
                whenUnsatisfiable: ScheduleAnyway
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 512Mi
          registry:
            replicas: 3
            podDisruptionBudget:
              enabled: true
              minAvailable: 2
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 512Mi
          jobservice:
            replicas: 2
            jobLoggers:
              - stdout
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 512Mi
          trivy:
            enabled: true
            replicas: 2
            resources:
              requests:
                cpu: 250m
                memory: 512Mi
              limits:
                memory: 1Gi

