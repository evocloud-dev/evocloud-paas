---
############################################
#DEPLOYING HARBOR
############################################
# Reference: https://github.com/goharbor/harbor-helm

# https://kubernetes-schemas.pages.dev/fluxcd.controlplane.io/resourceset_v1.json
apiVersion: fluxcd.controlplane.io/v1
kind: ResourceSet
metadata:
  name: harbor-registry
  namespace: flux-system
  annotations:
    fluxcd.controlplane.io/reconcile: "enabled"
    fluxcd.controlplane.io/reconcileEvery: "1h"
    fluxcd.controlplane.io/reconcileTimeout: "20m"
spec:
  dependsOn:
    - apiVersion: fluxcd.controlplane.io/v1
      kind: FluxInstance
      name: flux
      namespace: flux-system
      ready: true
    # Add dependsOn storageClass
    # Add dependsOn Monitoring Stack
    # Add dependsOn Cert-Manager

  resources:
    #Create Namespace
    - apiVersion: v1
      kind: Namespace
      metadata:
        name: harbor

    #Create OCI Repository
    - apiVersion: source.toolkit.fluxcd.io/v1
      kind: OCIRepository
      metadata:
        name: kubeapp-harbor
        namespace: flux-system
      spec:
        interval: 12h
        url: oci://ghcr.io/evocloud-dev/charts/harbor
        layerSelector:
          mediaType: "application/vnd.cncf.helm.chart.content.v1.tar+gzip"
          operation: copy
        ref:
          semver: "1.19.*"
        #verify:
        #  provider: cosign
        #  matchOIDCIdentity:
        #    - issuer: ^https://token.actions.githubusercontent.com$
        #      subject: ^https://github.com/goharbor/harbor.*$

    #Deploy Helm Release
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      metadata:
        name: kubeapp-harbor
        namespace: harbor
      spec:
        releaseName: harbor
        chartRef:
          kind: OCIRepository
          name: kubeapp-harbor
          namespace: flux-system
        interval: 30m
        timeout: 15m0s   # core crash-loops until Postgres is ready; give it room
        install:
          remediation:
            retries: 3
        upgrade:
          cleanupOnFail: true
          remediation:
            retries: 2
        driftDetection:
          mode: enabled
        values:
          logLevel: error
          externalURL: https://harbor.{{ domain_tld }}
          expose:
            type: route # Type route enables Gateway API
            route:
              annotations:
                forecastle.stakater.com/expose: "true"
                forecastle.stakater.com/icon: "https://raw.githubusercontent.com/cncf/artwork/refs/heads/main/projects/harbor/icon/color/harbor-icon-color.svg"
                forecastle.stakater.com/appName: "Harbor OCI Repository"
                forecastle.stakater.com/group: "APIs & Interfaces"
                forecastle.stakater.com/instance: "Evodashboard"
                forecastle.stakater.com/properties: "Platform:EvoCloud, Version:1.19.4"
                forecastle.stakater.com/network-restricted: "true"
              parentRefs:
                - name: shared-gtw            # Name of your specific Gateway
                  namespace: evocloud-ns      # Namespace of your specific Gateway
                  sectionName: https-harbor   # the HTTPS listener for Harbor
                  group: gateway.networking.k8s.io
                  kind: Gateway
              hosts:
                - harbor.{{ domain_tld }}
            tls:
              enabled: true
              certSource: none #Certificates are dynamically provisioned by cert-manager in the Gateway resource
          trace:
            enabled: false
            # trace provider: jaeger or otel
            provider: otel
            otel:
              endpoint: hostname:4318
              url_path: /v1/traces
              compression: false
              insecure: true
              # timeout is in seconds
              timeout: 10
          harborAdminPassword: "Harbor12345!" #Change this to something more secure
          secretKey: "0630c7f4f70329b29aa8dc84cedf75e0"       # must be exactly 16 Characters long: openssl rand -hex 16
          persistence:
            enabled: true
            imageChartStorage:
              disableredirect: false   # true = registry proxies blob traffic instead of redirecting clients to S3
              # Specify the type of storage: "filesystem", "azure", "gcs", "s3", "swift", "oss"
              type: filesystem
              s3:
                accesskey: "CHANGE_ME" 
                secretkey: "CHANGE_ME"
                region: "CHANGE_ME"
                bucket: "CHANGE_ME"
                encrypt: true
                secure: true
                v4auth: true
              gcs:
                bucket: bucketname
                # The base64 encoded json file which contains the key
                encodedkey: base64-encoded-json-key-file
                #rootdirectory: /gcs/object/name/prefix
                #chunksize: "5242880"
                # To use existing secret, the key must be GCS_KEY_DATA
                existingSecret: ""
                useWorkloadIdentity: false
              oss:
                accesskeyid: accesskeyid
                accesskeysecret: accesskeysecret
                region: regionname
                bucket: bucketname
                # key in existingSecret must be REGISTRY_STORAGE_OSS_ACCESSKEYSECRET
                existingSecret: ""
                #endpoint: endpoint
                #internal: false
                #encrypt: false
                #secure: true
                #chunksize: 10M
                #rootdirectory: rootdirectory
            persistentVolumeClaim:
              trivy:
                size: 10Gi
              database:
                size: 50Gi
          # Harbor's bundled Postgres -- single replica, own PVC, no HA
          database:
            type: internal
            internal:
              resources:
                requests:
                  cpu: 250m
                  memory: 256Mi
                limits:
                  memory: 512Mi
            maxIdleConns: 20
            maxOpenConns: 100
          # Bundled Redis for now. Switch to type: external when you pick one.
          redis:
            type: internal
          portal:
            replicas: 2
            resources:
              requests:
                cpu: 100m
                memory: 128Mi
              limits:
                memory: 256Mi
          core:
            replicas: 3
            podDisruptionBudget:
              enabled: true
              minAvailable: 2
            topologySpreadConstraints:
              - maxSkew: 1
                topologyKey: topology.kubernetes.io/zone
                whenUnsatisfiable: ScheduleAnyway
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 512Mi
          registry:
            replicas: 3
            podDisruptionBudget:
              enabled: true
              minAvailable: 2
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 512Mi
          jobservice:
            replicas: 2
            jobLoggers:
              - stdout
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 512Mi
          trivy:
            enabled: true
            replicas: 2
            resources:
              requests:
                cpu: 250m
                memory: 512Mi
              limits:
                memory: 1Gi
